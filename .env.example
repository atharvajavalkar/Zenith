# Database (PostgreSQL for Docker, or sqlite+aiosqlite:///./algo.db for local dev)
DATABASE_URL=postgresql://algo:algo@postgres:5432/algo

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend (build-time for Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Postgres container
POSTGRES_USER=algo
POSTGRES_PASSWORD=algo
POSTGRES_DB=algo

# TradingView data — anonymous feed works without login (default)
TV_USE_LOGIN=false
TV_USERNAME=
TV_PASSWORD=
FETCH_RETRIES=4
FETCH_DELAY_SECONDS=2.0
FETCH_BETWEEN_TF_DELAY=1.5

# Broker: XM via MetaTrader 5
# TRADE_MODE=paper → simulated trades, no broker account needed (default)
# TRADE_MODE=live  → real orders via XM/MT5 (MT5 must be running with Algo Trading enabled)
TRADE_MODE=paper
AUTO_TRADE_ENABLED=true
BROKER=xm

# XM / MT5 credentials — fill these in when ready to go live
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=                 # e.g. XMGlobal-MT5 2  (check File > Open an Account in MT5)
MT5_PATH=                   # e.g. C:\Program Files\XM Global MT5\terminal64.exe
MT5_SYMBOL=XAUUSD           # confirm exact name in MT5 Market Watch
MT5_BRIDGE_URL=             # optional: http://<vps-ip>:9000  if MT5 runs on separate Windows VPS

# Price feed — XM on TradingView (anonymous, no login needed)
SYMBOL=XAUUSD
EXCHANGE=XM

# Legacy OANDA (leave empty — only used as last-resort candle fallback)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_INSTRUMENT=XAU_USD

TRADE_UNITS=0
TRADE_LOT_SIZE=0.1
UNITS_PER_LOT=100
MARGIN_LEVERAGE=1000
TRAIL_PROFIT_LOCK=0.50

# Worker: 0.1s SL/TP tick monitor, 5s signal poll
# Production: TRADE_5M_MODE=true → 3 trades per 5M candle on 3M/5M zones
# Test mode: TRADE_5M_MODE=false → up to 5 trades/min on 1M/5M zones
TICK_INTERVAL_SECONDS=0.1
PRICE_FETCH_SECONDS=1
POLL_INTERVAL_SECONDS=5
MINUTE_SL_ATR=1.0
TRADE_5M_MODE=true
MAX_TRADES_PER_5M=3
TRADE_INTERVAL_SECONDS=100
MAX_TRADES_PER_MINUTE=5
ML_GATE_ENABLED=true
BIAS_GATE_ENABLED=false
ADAPTIVE_LEARNING=true
MIN_TRAIN_SAMPLES=12
LOSS_PNL_PROTECT=-150
LOSS_STREAK_REDUCE_AT=3
MC_FLOOR_BASE=50
DIRECTION_LOCK_5M=true
BLOCK_OPPOSITE_OPEN=true
